{
  "name": "alola-logistics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3101",
    "dev:3101": "next dev -p 3101",
    "dev:3001": "next dev -p 3001",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3101 -H 0.0.0.0",
    "start:3001": "next start -p 3001",
    "seed": "tsx prisma/seed-docs.ts",
    "build:prod": "prisma generate && next build && npm run copy:standalone",
    "start:prod": "node .next-prod/standalone/server.js",
    "copy:standalone": "node scripts/copy-standalone.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "cron:quotes": "node --env-file=.env scripts/cron-expire-quotes.mjs",
    "cron:quotes:once": "node --env-file=.env scripts/cron-expire-quotes.mjs --once",
    "cron:ship24": "SHIP24_LOOP=1 tsx --env-file=.env scripts/cron-ship24.ts",
    "cron:ship24:once": "tsx --env-file=.env scripts/cron-ship24.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "5.7.1",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "1.31.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.11",
    "pino": "10.3.1",
    "radix-ui": "^1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.85.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/exceljs": "^1.3.2",
    "@types/node": "^22",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.6",
    "prisma": "5.22.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "~5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
